# Copy to .env (git-ignored). Leave a section empty to turn that feature off.

# Clerk login — dashboard.clerk.com → your app → API keys → Publishable key.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase cloud sync (needs Clerk too) — Supabase dashboard → Project Settings → API.
# Publishable keys are meant to ship inside apps; row-level security protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Smart Saves (AI) UI. Leave unset/false for the beta. Only "true" turns it on.
# The edge function has its own server-side switch: the SMART_SAVES_ENABLED function secret
# (also off unless exactly "true"), so the AI can't run even if this is set in a client build.
EXPO_PUBLIC_SMART_SAVES_ENABLED=
