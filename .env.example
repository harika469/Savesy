# Copy to .env (git-ignored) to turn on cloud sync. Leave empty to keep Savesy local-only.
# Supabase dashboard → Project Settings → API (Data API URL + publishable/anon key).
# The publishable key is meant to ship inside apps; row-level security protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
